    "command": {
      "action": "panel.set_primary",
      "panel_type": "browser"
    }
  },
  "panel.fullscreen": {
    "type": "ui_command",
    "command": {
      "action": "panel.fullscreen",
      "panel_type": "media"
    }
  },
  "layout.restore": {
    "type": "ui_command",
    "command": {
      "action": "layout.restore"
    }
  },
  "notification.show": {
