{
  "$defs": {
    "AudioPlay": {
      "properties": {
        "action": {
          "const": "audio.play",
          "default": "audio.play",
          "title": "Action",
          "type": "string"
        },
        "asset": {
          "title": "Asset",
          "type": "string"
        }
      },
      "required": [
        "asset"
      ],
      "title": "AudioPlay",
      "type": "object"
    },
    "LayoutApply": {
      "properties": {
        "action": {
          "const": "layout.apply",
          "default": "layout.apply",
          "title": "Action",
          "type": "string"
        },
        "template": {
          "$ref": "#/$defs/LayoutTemplate"
        },
        "primary_panel": {
          "$ref": "#/$defs/PanelType"
        },
        "secondary_panel": {
          "anyOf": [
            {
              "$ref": "#/$defs/PanelType"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "slots": {
          "anyOf": [
            {
              "$ref": "#/$defs/LayoutSlots"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "preserve": {
          "default": true,
          "title": "Preserve",
          "type": "boolean"
        }
      },
      "required": [
        "template",
        "primary_panel"
      ],
      "title": "LayoutApply",
      "type": "object"
    },
    "LayoutRestore": {
      "properties": {
        "action": {
          "const": "layout.restore",
          "default": "layout.restore",
          "title": "Action",
          "type": "string"
        }
      },
      "title": "LayoutRestore",
      "type": "object"
    },
    "LayoutSlots": {
      "description": "Panel\u2192slot assignments for multi-zone layouts.\n\n``main`` is always populated (frozen invariant). ``side``/``rail``/\n``dock`` are optional. The model never sends coordinates \u2014 only\nassignments; the engine owns geometry.",
      "properties": {
        "main": {
          "$ref": "#/$defs/PanelType"
        },
        "side": {
          "anyOf": [
            {
              "$ref": "#/$defs/PanelType"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "rail": {
          "anyOf": [
            {
              "$ref": "#/$defs/PanelType"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "dock": {
          "anyOf": [
            {
              "$ref": "#/$defs/PanelType"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "main"
      ],
      "title": "LayoutSlots",
      "type": "object"
    },
    "LayoutTemplate": {
      "enum": [
        "focus",
        "split",
        "reading",
        "dashboard",
        "reference",
        "background_media"
      ],
      "title": "LayoutTemplate",
      "type": "string"
    },
    "MediaState": {
      "enum": [
        "playing",
        "paused",
        "stopped"
      ],
      "title": "MediaState",
      "type": "string"
    },
    "MediaStateChange": {
      "properties": {
        "action": {
          "const": "media.state",
          "default": "media.state",
          "title": "Action",
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/MediaState"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "volume": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Volume"
        }
      },
      "required": [
        "state"
      ],
      "title": "MediaStateChange",
      "type": "object"
    },
    "NotificationKind": {
      "enum": [
        "reminder",
        "alarm",
        "info",
        "error"
      ],
      "title": "NotificationKind",
      "type": "string"
    },
    "NotificationShow": {
      "properties": {
        "action": {
          "const": "notification.show",
          "default": "notification.show",
          "title": "Action",
          "type": "string"
        },
        "notification_id": {
          "title": "Notification Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/NotificationKind"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "sound": {
          "default": false,
          "title": "Sound",
          "type": "boolean"
        },
        "snoozable": {
          "default": true,
          "title": "Snoozable",
          "type": "boolean"
        }
      },
      "required": [
        "notification_id",
        "kind",
        "title",
        "text"
      ],
      "title": "NotificationShow",
      "type": "object"
    },
    "PanelClose": {
      "properties": {
        "action": {
          "const": "panel.close",
          "default": "panel.close",
          "title": "Action",
          "type": "string"
        },
        "panel_type": {
          "anyOf": [
            {
              "$ref": "#/$defs/PanelType"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "panel_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Panel Id"
        }
      },
      "title": "PanelClose",
      "type": "object"
    },
    "PanelFullscreen": {
      "properties": {
        "action": {
          "const": "panel.fullscreen",
          "default": "panel.fullscreen",
          "title": "Action",
          "type": "string"
        },
        "panel_type": {
          "$ref": "#/$defs/PanelType"
        }
      },
      "required": [
        "panel_type"
      ],
      "title": "PanelFullscreen",
      "type": "object"
    },
    "PanelOpen": {
      "properties": {
        "action": {
          "const": "panel.open",
          "default": "panel.open",
          "title": "Action",
          "type": "string"
        },
        "panel_type": {
          "$ref": "#/$defs/PanelType"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "content_reference": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Reference"
        }
      },
      "required": [
        "panel_type"
      ],
      "title": "PanelOpen",
      "type": "object"
    },
    "PanelSetPrimary": {
      "properties": {
        "action": {
          "const": "panel.set_primary",
          "title": "Action",
          "type": "string"
        },
        "panel_type": {
          "$ref": "#/$defs/PanelType"
        }
      },
      "required": [
        "action",
        "panel_type"
      ],
      "title": "PanelSetPrimary",
      "type": "object"
    },
    "PanelType": {
      "enum": [
        "conversation",
        "browser",
        "youtube",
        "media",
        "book_reader",
        "document_editor",
        "news",
        "notes",
        "tasks",
        "reminders",
        "telegram_preview",
        "confirmation",
        "settings",
        "notification"
      ],
      "title": "PanelType",
      "type": "string"
    },
    "TtsSpeak": {
      "properties": {
        "action": {
          "const": "tts.speak",
          "default": "tts.speak",
          "title": "Action",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "priority": {
          "default": false,
          "title": "Priority",
          "type": "boolean"
        }
      },
      "required": [
        "text"
      ],
      "title": "TtsSpeak",
      "type": "object"
    }
  },
  "discriminator": {
    "mapping": {
      "audio.play": "#/$defs/AudioPlay",
      "layout.apply": "#/$defs/LayoutApply",
      "layout.restore": "#/$defs/LayoutRestore",
      "media.state": "#/$defs/MediaStateChange",
      "notification.show": "#/$defs/NotificationShow",
      "panel.close": "#/$defs/PanelClose",
      "panel.fullscreen": "#/$defs/PanelFullscreen",
      "panel.open": "#/$defs/PanelOpen",
      "panel.set_primary": "#/$defs/PanelSetPrimary",
      "tts.speak": "#/$defs/TtsSpeak"
    },
    "propertyName": "action"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/LayoutApply"
    },
    {
      "$ref": "#/$defs/PanelOpen"
    },
    {
      "$ref": "#/$defs/PanelClose"
    },
    {
      "$ref": "#/$defs/PanelSetPrimary"
    },
    {
      "$ref": "#/$defs/PanelFullscreen"
    },
    {
      "$ref": "#/$defs/LayoutRestore"
    },
    {
      "$ref": "#/$defs/NotificationShow"
    },
    {
      "$ref": "#/$defs/MediaStateChange"
    },
    {
      "$ref": "#/$defs/TtsSpeak"
    },
    {
      "$ref": "#/$defs/AudioPlay"
    }
  ]
}
